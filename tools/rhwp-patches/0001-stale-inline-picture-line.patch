+
+    /// 글자처럼 취급한 그림이 저장된 줄 하나보다 훨씬 크면 그 줄 높이를 그림에 맞춘다.
+    ///
+    /// 한컴이 정상 저장한 문단은 줄 높이가 그 줄의 그림 높이를 포함한다. 그림 높이가
+    /// 저장 줄 높이를 크게 넘는 문단은 그림을 넣은 뒤 줄 정보가 갱신되지 않은 것이라
+    /// 믿을 수 없다 — 그대로 두면 그림이 줄 밖으로 넘쳐 뒤 문단과 겹치고 뒤 그림에 가려진다.
+    /// 줄이 하나뿐인 본문 문단만 다룬다(여러 줄은 그림이 줄마다 나뉘어 소속 판정이 필요하다).
+    fn grow_stale_inline_picture_lines(document: &mut Document) {
+        for section in &mut document.sections {
+            for para in &mut section.paragraphs {
+                if para.line_segs.len() != 1 {
+                    continue;
+                }
+                let tallest = para
+                    .controls
+                    .iter()
+                    .filter_map(|control| match control {
+                        Control::Picture(picture) if picture.common.treat_as_char => {
+                            Some(picture.common.height as i32)
+                        }
+                        _ => None,
+                    })
+                    .max()
+                    .unwrap_or(0);
+                let seg = &mut para.line_segs[0];
+                if seg.line_height <= 0
+                    || seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                    || i64::from(tallest) * 4 <= i64::from(seg.line_height) * 5
+                {
+                    continue;
+                }
+                seg.line_height = tallest;
+                seg.text_height = tallest;
+                seg.baseline_distance = (i64::from(tallest) * 85 / 100) as i32;
+            }
+        }
+    }
 
