         // 문서 순서로 번호 문자열을 정해 둔다.
         crate::renderer::layout::assign_numbering_markers(&mut document.sections, &styles);
+        Self::grow_stale_inline_picture_lines(&mut document);
         Self::reflow_zero_height_paragraphs(
             &mut document,
             &styles,
@@ -476,6 +477,43 @@
             }
         }
